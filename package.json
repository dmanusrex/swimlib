{
  "name": "swimlib",
  "version": "0.0.0",
  "description": "Read and write common swimming data formats: SDIF (SD3/CL2), Hy-Tek HY3, EV3 event files, REC record files, and STD/ST2 time standards.",
  "keywords": [
    "swimming",
    "sdif",
    "sd3",
    "cl2",
    "hy3",
    "ev3",
    "hytek",
    "hy-tek",
    "meet manager",
    "team manager",
    "time standards",
    "records"
  ],
  "license": "MIT",
  "author": "Darren Richer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dmanusrex/swimlib.git"
  },
  "homepage": "https://github.com/dmanusrex/swimlib#readme",
  "bugs": {
    "url": "https://github.com/dmanusrex/swimlib/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "PROVENANCE.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "typesVersions": {
    "*": {
      "core": [
        "./dist/core/index.d.cts"
      ],
      "rec": [
        "./dist/rec/index.d.cts"
      ],
      "std": [
        "./dist/std/index.d.cts"
      ],
      "sdif": [
        "./dist/sdif/index.d.cts"
      ],
      "hy3": [
        "./dist/hy3/index.d.cts"
      ],
      "ev3": [
        "./dist/ev3/index.d.cts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core/index.d.ts",
        "default": "./dist/core/index.js"
      },
      "require": {
        "types": "./dist/core/index.d.cts",
        "default": "./dist/core/index.cjs"
      }
    },
    "./rec": {
      "import": {
        "types": "./dist/rec/index.d.ts",
        "default": "./dist/rec/index.js"
      },
      "require": {
        "types": "./dist/rec/index.d.cts",
        "default": "./dist/rec/index.cjs"
      }
    },
    "./std": {
      "import": {
        "types": "./dist/std/index.d.ts",
        "default": "./dist/std/index.js"
      },
      "require": {
        "types": "./dist/std/index.d.cts",
        "default": "./dist/std/index.cjs"
      }
    },
    "./sdif": {
      "import": {
        "types": "./dist/sdif/index.d.ts",
        "default": "./dist/sdif/index.js"
      },
      "require": {
        "types": "./dist/sdif/index.d.cts",
        "default": "./dist/sdif/index.cjs"
      }
    },
    "./hy3": {
      "import": {
        "types": "./dist/hy3/index.d.ts",
        "default": "./dist/hy3/index.js"
      },
      "require": {
        "types": "./dist/hy3/index.d.cts",
        "default": "./dist/hy3/index.cjs"
      }
    },
    "./ev3": {
      "import": {
        "types": "./dist/ev3/index.d.ts",
        "default": "./dist/ev3/index.js"
      },
      "require": {
        "types": "./dist/ev3/index.d.cts",
        "default": "./dist/ev3/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run lint:package",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "lint:package": "publint && attw --pack .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "changeset": "changeset",
    "prepublishOnly": "npm run check",
    "release": "changeset publish"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.43",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "publint": "^0.3.24",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.9"
  },
  "allowScripts": {
    "esbuild@0.27.2": true
  }
}
